# 复制为 .env 后按需修改。.env 不入库（.gitignore 已挡）。
# 铁律：配置只从 core/config.py 的 Settings 读取，业务代码里禁止 os.getenv。

# ---------- 应用 ----------
DEBUG=true
# 生产环境（DEBUG=false）下留空会让应用启动即失败 —— 这是刻意设计，不要改成 warning
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# ---------- MySQL（阿里云 ECS，经 SSH 隧道）----------
# ⚠️ HOST/PORT 指向的是**本机隧道入口**，不是 ECS 本身。
#    阿里云安全组把 3306 挡在公网之外（那台机器 2026-10-01 正是因为数据库暴露
#    在公网才被勒索），所以必须先跑 deploy/tunnel.py 把本机端口映射过去。
#    端口用 13306 而不是 3306：万一本机也起了 MySQL，撞端口会连错库，
#    而症状是"认证失败"——排查方向完全不对。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
# 专用账号，只授予 security_assessment 一个库，且只允许从 ECS 的 Docker 网桥连入
MYSQL_USER=asa_user
MYSQL_PASSWORD=
MYSQL_DATABASE=security_assessment

# ---------- Redis（同一台 ECS，同一条隧道）----------
# 复用既有实例，但必须用独立 db index（3）；该实例的 db 0 属于别的服务，绝不触碰。
# 该实例 requirepass 为空（无认证），边界由隧道提供 —— 见 vibecoding_doc/ECS安全现状.md
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=
REDIS_DB=3

# ---------- LLM ----------
# ⚠️ API Key 只从这里读，不入库、不经任何接口返回。
#    这样设计是为了避免密钥随数据库备份/导出而泄露。
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---------- 沙箱（远程 Docker）----------
# **两种部署形态，二选一**：
#
# ① worker 与 Docker 在**同一台机器**上（ECS 上的生产部署）—— 留空即可。
#    留空时 docker-py 走本地 unix socket。挂载路径就是真实路径，
#    不存在「容器里看到的路径 ≠ 宿主机解析的路径」这类问题。
#
# ② worker 在**别的机器**上，Docker 在 ECS —— 用 ssh://。
#    ⚠️ Docker SDK 的 ssh:// 传输**不支持密码认证**，必须先配好密钥：
#       ssh-copy-id -i ~/.ssh/id_rsa.pub root@<ecs>
#    ⚠️ `DOCKER_SSH_KEY_PATH` 目前**不生效**：docker-py 的 ssh 传输没有
#       接收密钥路径的入口（shell-out 模式只是 spawn 一个 `ssh <host> ...`，
#       密钥由 ssh 自己的配置决定）。留空，改用 `~/.ssh/config` 指定 IdentityFile。
DOCKER_HOST=ssh://root@your-ecs-host
DOCKER_SSH_KEY_PATH=

#: Git 地址白名单（PRD §12 风险 8）。**DEBUG=false 时必填，留空会拒绝启动** ——
#: 公网可达又不限制可扫仓库的话，本系统就是「任意仓库克隆 + 自动攻击」的跳板。
#:
#: ⚠️ **必须是 JSON 数组，逗号分隔会直接崩**：
#:    pydantic-settings 对 list[str] 走 JSON 解析，写成
#:    `https://a/,https://b/` 会在 **import 期**抛 SettingsError
#:    （不是启动后报错，是 `import app.core.config` 就炸，traceback 很难读）。
#:    单条也要写成数组。开发态（DEBUG=true）可以留空，表示不限制。
GIT_URL_ALLOWLIST=[]
# 生产示例：
# GIT_URL_ALLOWLIST=["https://gitee.com/your-org/", "https://github.com/your-org/"]
#: 数据面上存放解包后源码的根目录（契约 5 的「数据面路径空间」）
ECS_SOURCE_ROOT=/srv/asa/tasks
SANDBOX_DEFAULT_IMAGE=asa/sandbox-base:latest

# ---------- 控制面工作区（两个路径空间，别混）----------
#: 上传的源码归档解包到哪里（`projects.storage_path` 相对它）
WORKSPACE_ROOT=D:/myself_complete_code/.asa/workspaces
#: 报告落盘到哪里。**与 WORKSPACE_ROOT 分开**是有意的：报告的保留策略
#: （按需清理旧报告）与源码工作区（项目删了就清）完全不同，
#: 混在一棵树下会让「清源码」顺手把报告也删了。
REPORT_ROOT=D:/myself_complete_code/.asa/reports

# ---------- 编排（一般不用改，列出来是为了让阈值可见）----------
#: 并发恒为 1（T3）。这行不是开关，是文档 —— 改成 2 需要先解决
#: 编排引擎的单实例内存态（LogBroadcaster 的摘要缓冲）问题。
#: 单次评估的总超时（秒）
ASSESSMENT_TIMEOUT_SECONDS=3600
#: 单条任务失败重试次数；超过就进死信队列并评估判 failed
TASK_MAX_RETRIES=3
#: 日志流的 XTRIM 上限（近似裁剪）
LOG_STREAM_MAXLEN=5000
#: 阶段结束时落库的日志摘要上限（行数 / 字节数**双重**约束）
LOG_EXCERPT_MAX_LINES=100
LOG_EXCERPT_MAX_BYTES=8192
